# =============================================================================
# DOCKER IGNORE - Files to exclude from Docker build context
# =============================================================================
# This makes docker build faster by excluding unnecessary files

# Git
.git
.gitignore

# IDE
.idea
*.iml
.vscode

# Build artifacts (we rebuild inside Docker)
target/
*.jar

# Frontend (built separately)
frontend/node_modules
frontend/dist

# Environment files (contain secrets)
.env
.env.local
.env.*.local

# Documentation
*.md
docs/

# Test files
*.test.js
*.spec.js

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
.DS_Store

# Data files
data/
uploads/
*.sqlite


